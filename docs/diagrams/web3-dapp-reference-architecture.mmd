%%{init: {
  "theme": "base",
  "themeVariables": {
    "primaryColor": "#ffffff",
    "primaryTextColor": "#111111",
    "primaryBorderColor": "#333333",
    "lineColor": "#444444",
    "secondaryColor": "#f0f0f0",
    "tertiaryColor": "#e0e0e0",
    "background": "#ffffff",
    "mainBkg": "#ffffff",
    "nodeBorder": "#333333",
    "clusterBkg": "#f7f7f7",
    "clusterBorder": "#666666",
    "titleColor": "#111111",
    "edgeLabelBackground": "#ffffff",
    "fontFamily": "ui-sans-serif, system-ui, sans-serif"
  }
}}%%
flowchart LR
  %% Grayscale only: black / white / gray

  classDef actor fill:#ffffff,stroke:#111111,stroke-width:2px,color:#111111
  classDef client fill:#f5f5f5,stroke:#333333,stroke-width:2px,color:#111111
  classDef offchain fill:#ececec,stroke:#444444,stroke-width:2px,color:#111111
  classDef chain fill:#e2e2e2,stroke:#222222,stroke-width:2px,color:#111111
  classDef bridge fill:#fafafa,stroke:#555555,stroke-width:2px,color:#111111
  classDef external fill:#f0f0f0,stroke:#666666,stroke-width:2px,color:#111111

  subgraph USERS["Users & Wallets"]
    USER["User"]
    WALLET["Wallet"]
  end

  subgraph CLIENT["Client Layer"]
    DAPP["Web / Mobile dApp"]
    SDK["Web3 SDK<br/>RPC provider + contract ABI"]
  end

  subgraph OFFCHAIN["Off-Chain Services"]
    API["Backend / API<br/>Business logic and auth"]
    INDEXER["Indexer & Query API<br/>Events → searchable data"]
    RELAYER["Relayers / Keepers<br/>Automation and gas sponsorship"]
  end

  subgraph CHAIN["Blockchain Network"]
    RPC["RPC Nodes"]
    SC["Smart Contracts<br/>State, tokens, permissions"]
    STATE["On-chain State"]
  end

  subgraph BRIDGE["Bridge / Cross-chain Messaging"]
    XCHAIN["Bridge / Messaging<br/>Messages and token movement"]
  end

  subgraph EXTERNAL["External Data & Decentralized Storage"]
    ORACLE["Oracles / Data Providers"]
    IPFS["IPFS / Decentralized Storage"]
    ANALYTICS["Analytics & Monitoring"]
  end

  USER -->|uses| DAPP
  WALLET -->|connects / signs| DAPP
  DAPP -->|calls| SDK
  DAPP -.->|API requests| API
  DAPP -.->|query data| INDEXER
  SDK -->|read state / send tx| SC
  API -.->|server-side reads / relayed tx| RPC
  RPC -->|JSON-RPC| SC
  SC -->|events| INDEXER
  RELAYER -->|keeper calls| SC
  SC -->|writes state| STATE
  SC -->|lock / message| XCHAIN
  XCHAIN -->|receive message| SC
  ORACLE -->|oracle updates| SC
  SC -.->|content identifiers| IPFS
  IPFS -.->|metadata / media| DAPP
  SC -.->|activity| ANALYTICS
  SC -.->|metrics| ANALYTICS

  class USER,WALLET actor
  class DAPP,SDK client
  class API,INDEXER,RELAYER offchain
  class RPC,SC,STATE chain
  class XCHAIN bridge
  class ORACLE,IPFS,ANALYTICS external

  linkStyle default stroke:#444444,stroke-width:1.5px,color:#222222
